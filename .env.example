# In-container path (matches the volume mount below). 
# For non-Docker local runs, point this at your local config.json instead, e.g. ./config.json
MCP_CONFIG_PATH=/app/config.json
MCP_PORT=8199
MCP_USE_AUTH=0           # 0 = 'False', 1 = 'True'
MCP_AUTH_TOKEN=change-me # Can be empty if MCP_USE_AUTH=0
